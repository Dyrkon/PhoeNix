@using Humanizer
@using PhoeNix.WebAPP.Helpers

<MudExpansionPanel>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Small"/>
            <MudText Typo="Typo.body1">Status</MudText>
            <MudChip T="string"
                     Color="@Status.MachineState.ToMachineStateColor()"
                     Variant="Variant.Filled"
                     Size="Size.Small">
                @Status.MachineState.ToMachineStateLabel()
            </MudChip>
        </MudStack>
    </TitleContent>
    <ChildContent>
        <MudGrid Class="pt-2">
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption">State</MudText>
                <MudChip T="string"
                         Color="@Status.MachineState.ToMachineStateColor()"
                         Variant="Variant.Filled"
                         Size="Size.Small">
                    @Status.MachineState.ToMachineStateLabel()
                </MudChip>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption">Last Provisioned</MudText>
                <MudText Typo="Typo.body1">@Status.LastProvisioned.FormatDateTime()</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption">Last Orchestrated</MudText>
                <MudText Typo="Typo.body1">@Status.LastOrchestrated.FormatDateTime()</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption">Last Configured</MudText>
                <MudText Typo="Typo.body1">@Status.LastConfigured.FormatDateTime()</MudText>
            </MudItem>
        </MudGrid>
    </ChildContent>
</MudExpansionPanel>
