<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            @if (ErrorCode is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Style="width: 100%">
                    <MudStack Spacing="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2"><strong>@ErrorCode</strong></MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small"
                                           Title="Copy to clipboard"
                                           OnClick="CopyErrorToClipboardAsync"/>
                        </MudStack>
                        @if (CleanedErrorMessage is not null)
                        {
                            <pre style="margin: 0; width: 100%; white-space: pre-wrap; word-break: break-word; font-size: 0.75rem; font-family: monospace; max-height: 300px; overflow-y: auto; background: transparent;">@CleanedErrorMessage</pre>
                        }
                    </MudStack>
                </MudAlert>
            }

            @if (TestResults is { Count: > 0 })
            {
                @foreach (var test in TestResults.Where(t => !t.IsSuccess))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Style="width: 100%">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2"><strong>@test.TestName</strong></MudText>
                            @foreach (var error in test.Errors)
                            {
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@error.Name</MudText>
                                    <pre style="margin: 0; white-space: pre-wrap; word-break: break-word; font-size: 0.75rem; font-family: monospace; background: transparent;">Expected: @error.Expected
Got:      @error.Result</pre>
                                </MudStack>
                            }
                        </MudStack>
                    </MudAlert>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary">Close</MudButton>
    </DialogActions>
</MudDialog>
