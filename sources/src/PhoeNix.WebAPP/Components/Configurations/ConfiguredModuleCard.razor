@using PhoeNix.Contracts.Configurations
@using PhoeNix.Domain.Enums

<MudCard Outlined="true" Class="pa-0">
    <MudCardContent Class="pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon
                    Icon="@(Module.TemplateType == ModuleType.Generic ? Icons.Material.Filled.Share : Icons.Material.Filled.Memory)"
                    Color="Color.Default"
                    Size="Size.Small"/>
                <MudLink Typo="Typo.subtitle1" Href="@($"/templates/{Module.ModuleTemplateId}")" Class="d-flex align-center">
                    @Module.TemplateName
                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="ml-1"/>
                </MudLink>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (Module.RequiresSetupBindings)
                {
                    <MudTooltip Text="Requires setup bindings">
                        <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Color="Color.Warning"/>
                    </MudTooltip>
                }
                <MudChip T="string"
                         Color="@(Module.Enabled ? Color.Success : Color.Default)"
                         Variant="Variant.Filled"
                         Size="Size.Small">
                    @(Module.Enabled ? "Enabled" : "Disabled")
                </MudChip>
                <span @onclick:stopPropagation="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Title="Edit module values"
                                   OnClick="OpenEditDialogAsync"/>
                </span>
            </MudStack>
        </MudStack>

        @if (Module.Entries.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No entries configured.</MudText>
        }
        else
        {
            <MudTable Items="@Module.Entries" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Kind</MudTh>
                    <MudTh>Value</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudText Typo="Typo.body2">@context.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="Kind">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Kind</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Value">
                        <MudText Typo="Typo.body2" Style="word-break: break-all;">@ResolveEntryValue(context)</MudText>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (SupportedArchitectures.Count > 0)
        {
            <MudDivider Class="my-3"/>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Tests</MudText>

                @if (SupportedArchitectures.Count > 1)
                {
                    <MudSelect T="Architecture?"
                               Value="_selectedArch"
                               ValueChanged="OnArchitectureChangedAsync"
                               Dense="true"
                               Margin="Margin.Dense"
                               Style="max-width: 180px;"
                               Label="Architecture">
                        @foreach (var arch in SupportedArchitectures)
                        {
                            <MudSelectItem T="Architecture?" Value="@((Architecture?)arch)">@arch.ToArchitectureString()</MudSelectItem>
                        }
                    </MudSelect>
                }
                else if (_selectedArch.HasValue)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_selectedArch.Value.ToArchitectureString()</MudChip>
                }

                @if (_validationStatus is not null)
                {
                    @switch (_validationStatus.State)
                    {
                        case "Queued":
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                Queued
                            </MudChip>
                            break;
                        case "Running":
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                    Running
                                </MudChip>
                            </MudStack>
                            break;
                        case "Succeeded":
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                                Valid
                            </MudChip>
                            break;
                        case "Failed":
                            <MudTooltip Text="Click to view error details">
                                <MudIconButton Icon="@Icons.Material.Filled.Error"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="OpenErrorDialogAsync"/>
                            </MudTooltip>
                            break;
                    }
                }

                <MudTooltip Text="Modules requiring setup bindings will use placeholder values">
                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               StartIcon="@(_validationStatus?.State is "Failed" ? Icons.Material.Filled.Refresh : Icons.Material.Filled.PlayArrow)"
                               Disabled="@(_isValidating || !_selectedArch.HasValue)"
                               OnClick="ScheduleValidationAsync">
                        @(_validationStatus?.State is "Failed" ? "Retry" : "Validate")
                    </MudButton>
                </MudTooltip>
            </MudStack>
        }
    </MudCardContent>
</MudCard>
