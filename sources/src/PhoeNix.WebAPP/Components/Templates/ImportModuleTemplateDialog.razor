@using Microsoft.AspNetCore.Components.Forms

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Select a JSON file exported from a module template detail view. Single objects and arrays are both supported.
            </MudText>

            <InputFile id="templateImportFile" OnChange="OnFileSelectedAsync" accept=".json" style="display:none"/>
            <MudButton HtmlTag="label"
                       Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.AttachFile"
                       for="templateImportFile">
                Choose File
            </MudButton>

            @if (_parseError is not null)
            {
                <MudAlert Severity="Severity.Error">@_parseError</MudAlert>
            }

            @if (_parsed.Count > 0)
            {
                <MudAlert Severity="Severity.Info">
                    Ready to import: <strong>@_parsed.Count module template@(_parsed.Count != 1 ? "s" : "")</strong>
                    @if (_parsed.Count <= 5)
                    {
                        <ul style="margin: 4px 0 0 0; padding-left: 1.2em;">
                            @foreach (var t in _parsed)
                            {
                                <li>@t.Name</li>
                            }
                        </ul>
                    }
                </MudAlert>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="SubmitAsync"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(_parsed.Count == 0 || _isSubmitting)">
            Import
        </MudButton>
    </DialogActions>
</MudDialog>
