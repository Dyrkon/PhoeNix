@page "/machines/{machineId:guid}"
@using Humanizer
@using PhoeNix.Domain.Enums
@using PhoeNix.WebAPP.Components.Machines
@using PhoeNix.WebAPP.Helpers
@using PhoeNix.WebAPP.States

<MudStack Spacing="3">
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="d-flex mx-auto my-8"/>
    }
    else if (_machine is null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">
            Machine could not be loaded.
        </MudAlert>
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">@_machine.Title</MudText>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTooltip Text="@(_canUpdateTooltip)">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@(CurrentStatus == UpdateStatus.InProgress ? null : Icons.Material.Filled.Sync)"
                               Disabled="@(!CanUpdate || CurrentStatus == UpdateStatus.InProgress)"
                               OnClick="UpdateConfigurationAsync">
                        @if (CurrentStatus == UpdateStatus.InProgress)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2"/>
                            <span>Updating…</span>
                        }
                        else
                        {
                            <span>Update Configuration</span>
                        }
                    </MudButton>
                </MudTooltip>

                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="/">
                    Back to machines
                </MudButton>
            </MudStack>
        </MudStack>

        <MudCard>
            <MudCardContent>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudText Typo="Typo.h6">Machine Information</MudText>

                    @if (CurrentStatus != UpdateStatus.None)
                    {
                        @if (CurrentStatus == UpdateStatus.InProgress)
                        {
                            <MudTooltip Text="Update in progress…">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="@(_updateStatusTooltip)">
                                <MudIconButton Icon="@(_updateStatusIcon)"
                                               Color="@(_updateStatusColor)"
                                               Size="Size.Small"
                                               OnClick="OpenUpdateResultDialogAsync"/>
                            </MudTooltip>
                        }
                    }
                </MudStack>

                <MudGrid>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">Title</MudText>
                        <MudText Typo="Typo.body1">@_machine.Title</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">Enabled</MudText>
                        <MudChip T="string"
                                 Color="@(_machine.Enabled ? Color.Success : Color.Default)"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            @(_machine.Enabled ? "Enabled" : "Disabled")
                        </MudChip>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">MAC Address</MudText>
                        <MudText Typo="Typo.body1">@_machine.MacAddress.FormatMacAddress()</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">Architecture</MudText>
                        <MudText Typo="Typo.body1">@_machine.Architecture.ToArchitectureString()</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">Install Disk Preference</MudText>
                        <MudText Typo="Typo.body1">@_machine.InstallDiskSelectionPreference.ToString()</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">Current State</MudText>
                        <MudChip T="string"
                                 Color="@(_machine.MachineStatus.MachineState.ToMachineStateColor())"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            @_machine.MachineStatus.MachineState.ToMachineStateLabel()
                        </MudChip>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudExpansionPanels MultiExpansion="true" Elevation="0">

            <MachineStatusPanel Status="@_machine.MachineStatus"/>

            <MachineDeploymentSnapshotPanel Snapshot="@_machine.DeploymentSnapshot"/>

            <MachineHardwarePanels Hardware="@_machine.HardwareProfile"/>

            <MudExpansionPanel Disabled="@(_machine.SoftwareSnapshot is null)">
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small"/>
                        <MudText Typo="Typo.body1">Software Snapshot</MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    @if (_machine.SoftwareSnapshot is not null)
                    {
                        <MudText Typo="Typo.body1" Class="pt-2">
                            Software snapshot is present.
                        </MudText>
                    }
                </ChildContent>
            </MudExpansionPanel>

        </MudExpansionPanels>
    }
</MudStack>
