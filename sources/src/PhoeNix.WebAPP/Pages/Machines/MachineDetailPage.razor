@page "/machines/{machineId:guid}"
@using Humanizer
@using PhoeNix.Domain.Enums
@using PhoeNix.WebAPP.Components.Machines
@using PhoeNix.WebAPP.Helpers

<MudStack Spacing="3">
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="d-flex mx-auto my-8"/>
    }
    else if (_machine is null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">
            Machine could not be loaded.
        </MudAlert>
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">@_machine.Title</MudText>

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Href="/">
                Back to machines
            </MudButton>
        </MudStack>

        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-4">Machine Information</MudText>

                <MudGrid>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">Title</MudText>
                        <MudText Typo="Typo.body1">@_machine.Title</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">Enabled</MudText>
                        <MudChip T="string"
                                 Color="@(_machine.Enabled ? Color.Success : Color.Default)"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            @(_machine.Enabled ? "Enabled" : "Disabled")
                        </MudChip>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">MAC Address</MudText>
                        <MudText Typo="Typo.body1">@_machine.MacAddress.FormatMacAddress()</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">Architecture</MudText>
                        <MudText Typo="Typo.body1">@_machine.Architecture.ToArchitectureString()</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">Install Disk Preference</MudText>
                        <MudText Typo="Typo.body1">@_machine.InstallDiskSelectionPreference.ToString()</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption">Current State</MudText>
                        <MudText Typo="Typo.body1">@_machine.MachineStatus.MachineState.Humanize()</MudText>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudExpansionPanels MultiExpansion="true" Elevation="0">

            <MachineStatusPanel Status="@_machine.MachineStatus"/>

            <MachineDeploymentSnapshotPanel Snapshot="@_machine.DeploymentSnapshot"/>

            <MachineHardwarePanels Hardware="@_machine.HardwareProfile"/>

            <MudExpansionPanel Disabled="@(_machine.SoftwareSnapshot is null)">
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small"/>
                        <MudText Typo="Typo.body1">Software Snapshot</MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    @if (_machine.SoftwareSnapshot is not null)
                    {
                        <MudText Typo="Typo.body1" Class="pt-2">
                            Software snapshot is present.
                        </MudText>
                    }
                </ChildContent>
            </MudExpansionPanel>

        </MudExpansionPanels>
    }
</MudStack>
