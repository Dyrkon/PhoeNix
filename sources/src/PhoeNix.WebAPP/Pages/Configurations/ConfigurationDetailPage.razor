@page "/configurations/{ConfigurationId:guid}"
@using PhoeNix.Domain.Enums
@using PhoeNix.WebAPP.Components.Configurations

<MudStack Spacing="3">
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="d-flex mx-auto my-8"/>
    }
    else if (_configuration is null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">
            Configuration could not be loaded.
        </MudAlert>
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">@_configuration.Title</MudText>

            <MudSpacer></MudSpacer>

            <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                           Color="Color.Secondary"
                           Title="Export configuration"
                           OnClick="ExportAsync"/>

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Href="/configurations">
                Back to configurations
            </MudButton>
        </MudStack>

        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-4">Basic Information</MudText>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption">Title</MudText>
                        <MudText Typo="Typo.body1">@_configuration.Title</MudText>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption">Supported Architectures</MudText>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @if (_configuration.SupportedArchitectures.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">None</MudText>
                            }
                            else
                            {
                                @foreach (var architecture in _configuration.SupportedArchitectures)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @architecture.ToArchitectureString()
                                    </MudChip>
                                }
                            }
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.caption">Description</MudText>
                        <MudText Typo="Typo.body1">@_configuration.Description</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.caption">Inputs</MudText>
                        <MudText Typo="Typo.body1">@_configuration.Inputs.Count</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.caption">Shared Modules</MudText>
                        <MudText Typo="Typo.body1">@_configuration.Modules.Count</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.caption">Systems</MudText>
                        <MudText Typo="Typo.body1">@_configuration.Systems.Count</MudText>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudExpansionPanels MultiExpansion="true" Elevation="0">

            <MudExpansionPanel>
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Input" Size="Size.Small"/>
                            <MudText Typo="Typo.body1">Inputs</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @_configuration.Inputs.Count @(_configuration.Inputs.Count == 1 ? "input" : "inputs")
                            </MudText>
                        </MudStack>
                        <span @onclick:stopPropagation="true">
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenAddInputDialogAsync">
                                Add Input
                            </MudButton>
                        </span>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    @if (_configuration.Inputs.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pt-2">No inputs configured.</MudText>
                    }
                    else
                    {
                        <MudTable Items="@_configuration.Inputs" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Name</MudTh>
                                <MudTh>Source</MudTh>
                                <MudTh>Followers</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Name">@context.Name</MudTd>
                                <MudTd DataLabel="Source">
                                    <MudText Typo="Typo.body2" Style="word-break: break-all;">@context.Source</MudText>
                                </MudTd>
                                <MudTd DataLabel="Followers">@context.Followers.Count</MudTd>
                                <MudTd>
                                    <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       OnClick="@(() => OpenEditInputDialogAsync(context))"/>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => RemoveInputAsync(context.Id))"/>
                                    </MudStack>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </ChildContent>
            </MudExpansionPanel>

            <MudExpansionPanel>
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small"/>
                            <MudText Typo="Typo.body1">Shared Modules</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @_configuration.Modules.Count @(_configuration.Modules.Count == 1 ? "module" : "modules") applied
                                to all systems
                            </MudText>
                        </MudStack>
                        <span @onclick:stopPropagation="true">
                            <MudTooltip Text="@(_sharedModulesExpanded ? "Collapse all" : "Expand all")">
                                <MudIconButton Icon="@(_sharedModulesExpanded ? Icons.Material.Filled.UnfoldLess : Icons.Material.Filled.UnfoldMore)"
                                               Size="Size.Small"
                                               OnClick="ToggleSharedModulesAsync"/>
                            </MudTooltip>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenAddSharedModuleDialogAsync">
                                Add Module
                            </MudButton>
                        </span>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    @if (_configuration.Modules.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pt-2">No shared modules configured.</MudText>
                    }
                    else
                    {
                        <MudExpansionPanels @ref="_sharedModulePanels" MultiExpansion="true" Elevation="0" Class="pt-2">
                            @foreach (var module in _configuration.Modules)
                            {
                                <MudExpansionPanel>
                                    <TitleContent>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudLink Typo="Typo.body1" Href="@($"/templates/{module.ModuleTemplateId}")"
                                                     @onclick:stopPropagation="true">
                                                @module.TemplateName
                                            </MudLink>
                                            <MudChip T="string"
                                                     Color="@(module.Enabled ? Color.Success : Color.Default)"
                                                     Variant="Variant.Text"
                                                     Size="Size.Small">
                                                @(module.Enabled ? "Enabled" : "Disabled")
                                            </MudChip>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @module.Entries.Count @(module.Entries.Count == 1 ? "entry" : "entries")
                                            </MudText>
                                        </MudStack>
                                    </TitleContent>
                                    <ChildContent>
                                        <ConfiguredModuleCard Module="@module"
                                                              ConfigurationId="@ConfigurationId"
                                                              SupportedArchitectures="@_configuration.SupportedArchitectures"
                                                              OnModuleUpdated="ReloadAsync"/>
                                    </ChildContent>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }
                </ChildContent>
            </MudExpansionPanel>

            <MudExpansionPanel>
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Computer" Size="Size.Small"/>
                            <MudText Typo="Typo.body1">Systems</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @_configuration.Systems.Count @(_configuration.Systems.Count == 1 ? "system" : "systems")
                            </MudText>
                        </MudStack>
                        <span @onclick:stopPropagation="true">
                            <MudTooltip Text="@(_systemsExpanded ? "Collapse all" : "Expand all")">
                                <MudIconButton Icon="@(_systemsExpanded ? Icons.Material.Filled.UnfoldLess : Icons.Material.Filled.UnfoldMore)"
                                               Size="Size.Small"
                                               OnClick="ToggleSystemsAsync"/>
                            </MudTooltip>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenAddSystemDialogAsync">
                                Add System
                            </MudButton>
                        </span>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    @if (_configuration.Systems.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pt-2">No systems configured.</MudText>
                    }
                    else
                    {
                        <MudExpansionPanels @ref="_systemPanels" MultiExpansion="true" Elevation="0" Class="pt-2">
                            @foreach (var system in _configuration.Systems)
                            {
                                <MudExpansionPanel>
                                    <TitleContent>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="@Icons.Material.Filled.Computer" Size="Size.Small" Color="Color.Default"/>
                                                <MudText Typo="Typo.h6">@system.Name</MudText>
                                                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">
                                                    @system.Architecture.ToArchitectureString()
                                                </MudChip>
                                            </MudStack>
                                            <span @onclick:stopPropagation="true">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => OpenEditSystemDialogAsync(system.Id, system.Name))"/>
                                                    <MudButton Size="Size.Small"
                                                               Variant="Variant.Outlined"
                                                               StartIcon="@Icons.Material.Filled.Add"
                                                               OnClick="@(() => OpenAddSystemModuleDialogAsync(system.Id))">
                                                        Add Module
                                                    </MudButton>
                                                </MudStack>
                                            </span>
                                        </MudStack>
                                    </TitleContent>
                                    <ChildContent>
                                        <ConfiguredSystemCard System="@system"
                                                              ConfigurationId="@ConfigurationId"
                                                              ConfigurationArchitectures="@_configuration.SupportedArchitectures"
                                                              OnModuleUpdated="ReloadAsync"/>
                                    </ChildContent>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }
                </ChildContent>
            </MudExpansionPanel>

        </MudExpansionPanels>
    }
</MudStack>
