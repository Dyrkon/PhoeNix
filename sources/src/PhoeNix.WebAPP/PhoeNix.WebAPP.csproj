<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <!-- Workaround: .NET 10.0.300 Razor source generator rejects valid syntax patterns
             (RZ1021 on @if blocks, @switch case markup, is-pattern expressions in conditions)
             that the legacy Razor compiler handles correctly. Remove once SDK is updated. -->
        <UseRazorSourceGenerator>false</UseRazorSourceGenerator>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Humanizer" Version="3.0.10"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.*" PrivateAssets="all"/>
        <PackageReference Include="MudBlazor" Version="9.*"/>
        <PackageReference Include="MudBlazor.Extensions" Version="9.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PhoeNix.WebAPP.ApiClient\PhoeNix.WebAPP.ApiClient.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    </PropertyGroup>
</Project>
